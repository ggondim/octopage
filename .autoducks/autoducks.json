{
  "providers": {
    "its": "github",
    "git": "github",
    "llm": "claude"
  },
  "defaults": {
    "model": "claude-opus-4-8",
    "effort": "high",
    "base_branch": "main",
    "max_turns": 150
  },
  "product": {
    "enabled": true,
    "schedule": "0 9 * * *"
  },
  "checks": {
    "enabled": true,
    "max_iterations": 3
  },
  "resolver": {
    "auto": true
  },
  "review": {
    "auto_rework": true,
    "max_iterations": 3
  },
  "architect": {
    "auto": true
  },
  "engineer": {
    "auto": true
  },
  "reviewer": {
    "auto": true
  },
  "orchestrator": {
    "mode": "waves"
  }
}
