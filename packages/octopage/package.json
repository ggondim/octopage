{
  "name": "octopage",
  "version": "0.1.0",
  "description": "Static personal site/blog powered by GitHub Discussions and the Primer Brand design system.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./integration": "./src/integration.ts",
    "./components": "./src/components/index.ts",
    "./layouts/*": "./src/layouts/*",
    "./styles/*": "./src/styles/*",
    "./github": "./src/github/index.ts",
    "./loader": "./src/loader.ts",
    "./schema": "./src/schema.ts",
    "./virtual": {
      "types": "./src/virtual.d.ts"
    }
  },
  "files": [
    "src"
  ],
  "keywords": [
    "astro-integration",
    "withastro",
    "astro-loader",
    "github-discussions",
    "primer",
    "giscus"
  ],
  "peerDependencies": {
    "astro": "^7.0.0",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "@primer/react-brand": "^0.73.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.4.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "typesVersions": {
    "*": {
      "virtual": [
        "./src/virtual.d.ts"
      ]
    }
  }
}
