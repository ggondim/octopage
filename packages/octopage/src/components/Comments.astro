---
import { giscus } from 'octopage:config';
import { giscusAttributes } from '../giscus.ts';

export interface Props {
  /**
   * Discussion number, in `discussions` mode. Ignored in `code` mode, where
   * giscus derives the term from `location.pathname` in the browser.
   */
  discussion?: number;
  title?: string;
}

const { discussion, title = 'Comments' } = Astro.props;

// `comments: false` in octopage.config.ts renders nothing at all rather than an
// empty section with a heading over it.
const enabled = giscus !== null;

const attrs = enabled
  ? giscusAttributes({
      ...giscus,
      ...(giscus.mapping === 'number' && discussion !== undefined ? { term: String(discussion) } : {}),
    })
  : {};

// In `number` mode a page with no discussion has nothing to pair with; showing
// the widget would render giscus's "discussion not found" error to every reader.
const renderable = enabled && (giscus.mapping !== 'number' || discussion !== undefined);
---

{
  renderable && (
    <section class="octopage-comments" aria-label={title}>
      <script src="https://giscus.app/client.js" crossorigin="anonymous" async {...attrs} />
      <noscript>
        Comments are powered by GitHub Discussions and need JavaScript. You can read and post them
        directly on GitHub instead.
      </noscript>
    </section>
  )
}
