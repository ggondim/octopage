---
import '@primer/react-brand/lib/css/main.css';
import '@primer/react-brand/fonts/fonts.css';
import '../styles/octopage.css';
import { config } from 'octopage:config';

export interface Props {
  title: string;
  description?: string;
  /** Route of the current page, used for the canonical URL. */
  pathname?: string;
  colorMode?: 'light' | 'dark' | 'auto';
}

const { title, description = config.site.description, pathname = Astro.url.pathname, colorMode = 'auto' } = Astro.props;

const pageTitle = title === config.site.title ? title : `${title} · ${config.site.title}`;
const canonical = new URL(pathname, config.site.url).href;
---

<!doctype html>
<html lang={config.site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    <slot name="head" />
  </head>

  <!--
    Primer Brand themes entirely through this attribute: ThemeProvider renders a
    <div data-color-mode> and a React context that, as of v0.73, no component in
    the library actually consumes. Setting the attribute here rather than
    wrapping the tree in a React island means every Primer component themes
    correctly without hydrating anything, and without islands needing to share a
    React context they cannot share anyway.
  -->
  <body data-color-mode={colorMode}>
    <slot />
  </body>
</html>
