---
import { Heading, Label, Stack, Text } from '@primer/react-brand';
import Base from './Base.astro';
import Comments from '../components/Comments.astro';

export interface Props {
  title: string;
  description?: string;
  date?: string | Date;
  author?: string | null;
  labels?: string[];
  /** Discussion number backing this page, when there is one. */
  discussion?: number;
  discussionUrl?: string;
}

const { title, description, date, author, labels = [], discussion, discussionUrl } = Astro.props;

const published = date ? new Date(date) : null;
const isValidDate = published !== null && !Number.isNaN(published.getTime());
---

<Base title={title} description={description}>
  <main class="octopage-main">
    <article class="octopage-prose">
      <Heading as="h1" size="2">{title}</Heading>

      <div class="octopage-meta">
        {
          isValidDate && (
            <Text as="span" size="200" variant="muted">
              <time datetime={published.toISOString()}>
                {published.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </Text>
          )
        }
        {author && <Text as="span" size="200" variant="muted">by {author}</Text>}
        {labels.map((label) => <Label size="small">{label}</Label>)}
      </div>

      <slot />

      {
        discussionUrl && (
          <Text as="p" size="200" variant="muted">
            <a href={discussionUrl}>Discuss this page on GitHub →</a>
          </Text>
        )
      }
    </article>

    <Comments discussion={discussion} />
  </main>
</Base>
