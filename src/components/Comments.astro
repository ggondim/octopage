---
import { giscus } from 'octopage:config';

export interface Props {
  title?: string;
}

const { title = 'Comments' } = Astro.props;

/*
 * Comments for committed pages.
 *
 * These pair on the URL pathname: the page is a file, so there is no discussion
 * to point at by number, and the giscus bot opens the thread when a reader first
 * comments. Discussion-backed pages use GiscusWidget.tsx instead, because their
 * number is only known once the browser fetch resolves.
 */
const attrs = giscus ? { ...giscus, 'data-mapping': 'pathname' } : null;
---

{
  attrs && (
    <section class="octopage-comments" aria-label={title}>
      <script is:inline src="https://giscus.app/client.js" crossorigin="anonymous" async {...attrs} />
      <noscript>
        Comments are powered by GitHub Discussions and need JavaScript. You can read and post them
        on GitHub instead.
      </noscript>
    </section>
  )
}
