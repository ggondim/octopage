---
import '@primer/react-brand/lib/css/main.css';
import '@primer/react-brand/fonts/fonts.css';
import '../styles/octopage.css';

export interface Props {
  title: string;
  description?: string;
  colorMode?: 'light' | 'dark' | 'auto';
}

const { title, description = '', colorMode = 'auto' } = Astro.props;

// Site identity comes from astro.config.mjs, where Astro already keeps it.
const siteTitle = Astro.site ? new URL(Astro.site).hostname : '';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />

    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    <slot name="head" />
  </head>

  <!--
    Primer Brand themes entirely through `data-color-mode`: ThemeProvider renders
    a <div> carrying it, plus a React context that, as of v0.73, no component in
    the library reads. Setting the attribute here rather than wrapping the tree
    in a React island means every Primer component themes correctly without
    hydrating, and without islands needing to share a context they cannot.

    `data-light-theme` and `data-dark-theme` are for @primer/react, the product
    UI library, which resolves its own tokens from them whenever the colour mode
    is `auto`. They are inert on their own — nothing here reads them — and cost
    two attributes, which is less than the debugging session someone would spend
    on product components rendering colourless. See docs/guide.md.
  -->
  <body
    data-color-mode={colorMode}
    data-light-theme="light"
    data-dark-theme="dark"
    data-site={siteTitle}
  >
    <slot />
  </body>
</html>
