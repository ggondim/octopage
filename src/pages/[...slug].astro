---
import { getCollection, render } from 'astro:content';
import Content from '../layouts/Content.astro';
import { mdxComponents } from '../components/index.ts';
import { routeFor, routeToSlugParam } from '../lib/routing.ts';
import { config } from 'octopage:config';

/**
 * Committed content, prerendered.
 *
 * Discussion-backed pages are deliberately absent: they resolve in the browser
 * through 404.astro, so a discussion published a minute ago is live without a
 * build. Files go through Astro's own MDX pipeline, which is why they may
 * `import` components and ship no JavaScript.
 */
export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft);

  return pages.map((entry) => ({
    params: { slug: routeToSlugParam(routeFor(entry, config)) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content: Body } = await render(entry);
---

<Content
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date?.toISOString()}
  author={entry.data.author}
  labels={entry.data.labels}
>
  <Body components={mdxComponents} />
</Content>
