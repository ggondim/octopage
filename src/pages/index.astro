---
import { getCollection } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import { PostList, SiteHero } from '../components/index.ts';
import { routeFor } from '../lib/routing.ts';
import { resolveRepo } from '../lib/repo.ts';
import { config, site } from 'octopage:config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const entries = [
  ...(await getCollection('pages', ({ data }) => !data.draft)),
  ...(await getCollection('discussions', ({ data }) => !data.draft)),
];

const posts = entries
  .filter((entry) => routeFor(entry, config) !== '/')
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    href: `${base}${routeFor(entry, config)}/`,
    category: entry.collection === 'discussions' ? entry.data.category : undefined,
  }));

const repo = resolveRepo();
---

<Shell title={site.title} description={site.description}>
  <SiteHero
    title={site.title}
    description={site.description}
    actionHref={`https://github.com/${repo.owner}/${repo.name}`}
    actionText="View the repository"
  />

  <div style="margin-block-start: var(--base-size-48)">
    <PostList posts={posts} />
  </div>
</Shell>
